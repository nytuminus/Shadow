{
  "name": "shadow",
  "version": "2.0.0",
  "description": "Shadow — assistente pessoal por voz, com voz neural e controle do PC.",
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "scripts": {
    "start": "pnpm --filter @shadow/server start",
    "dev": "pnpm --filter @shadow/server dev",
    "app": "electron .",
    "dist": "electron-builder --win",
    "salas:install": "npm --prefix web install",
    "salas:build": "npm --prefix web run build",
    "salas:dev": "npm --prefix web run dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.shadow.assistente",
    "productName": "Shadow",
    "asar": false,
    "directories": {
      "output": "instalador"
    },
    "files": [
      "apps/desktop/**",
      "apps/server/**",
      "voz-local/**",
      "ferramentas/**",
      "package.json",
      ".env.example",
      "!apps/server/data/*.json",
      "!apps/server/node_modules/.bin/**",
      "!instalador/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "apps/server/public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shadow"
    }
  }
}
