# ============================================================
#  SHADOW — Configuração
#  Copie este arquivo para ".env" e preencha a sua chave.
# ============================================================

# Sua chave da API do Google Gemini (o "cérebro" do Jarvis).
# É GRÁTIS e não pede cartão de crédito.
# Pegue em: https://aistudio.google.com/apikey  ->  "Criar chave de API"
# Pode começar com "AIza..." ou "AQ...".
GEMINI_API_KEY=

# Modelo usado pelo Jarvis.
#   gemini-flash-latest    -> sempre o Flash mais atual (padrão, recomendado)
#   gemini-3.5-flash       -> versão específica, estável
#   gemini-3.1-flash-lite  -> mais leve e econômico
JARVIS_MODEL=gemini-flash-latest

# Modelo RESERVA. No plano grátis cada modelo tem a sua própria cota diária:
# quando a do principal acaba, o Shadow passa para este e continua funcionando
# em vez de ficar repetindo "estou no limite" até a virada do dia.
SHADOW_FALLBACK_MODEL=gemini-flash-lite-latest

# Modelo que transcreve a sua voz no modo APLICATIVO (o Electron não tem a
# escuta do Chrome). Deixe um modelo leve: é uma chamada por frase falada.
SHADOW_STT_MODEL=gemini-flash-lite-latest

# Porta do motor local (não precisa mudar).
PORT=4577

# Nome pelo qual o assistente chama você.
JARVIS_USER_NAME=Senhor

# Nome do assistente (também é a palavra de ativação que você fala).
ASSISTANT_NAME=Shadow

# Bordão: resposta fixa quando você pergunta se ele está aí.
SHADOW_CATCHPHRASE=O que é, desgraça?

# Motor de voz padrão:
#   local  -> voz baixada (Piper), ~0,3s, offline e de graça  [recomendado]
#   gemini -> voz do Gemini, mais bonita, mas ~3s e gasta cota
SHADOW_ENGINE=local

# Voz local (arquivos na pasta voz-local).
SHADOW_LOCAL_VOICE=pt_BR-faber-medium
# Velocidade da voz local: menor = mais rápido. 1.0 é o natural.
SHADOW_LOCAL_RATE=0.98

# Timbre da voz do Gemini (usado quando SHADOW_ENGINE=gemini).
#   Charon (grave/firme) · Algenib (rouca) · Enceladus (baixa) · Orus (firme)
#   Alnilam · Iapetus · Rasalgethi · Umbriel · Fenrir · Puck · Kore · Sulafat
SHADOW_VOICE=Charon

# SHADOW_TTS=off desliga a voz do Gemini de vez.
SHADOW_TTS=on

# ============================================================
#  SPOTIFY (opcional) — tocar músicas por comando. Precisa Premium.
#   1. https://developer.spotify.com/dashboard -> Create app
#   2. Redirect URI (exata): http://127.0.0.1:4577/api/spotify/callback
#   3. Marque "Web API", salve, e copie Client ID + Client Secret.
# ============================================================
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ============================================================
#  SALAS (plataforma da equipe — chamadas + chat estilo Discord)
# ============================================================
# BANCO DE DADOS
# Sem nada preenchido aqui, as Salas usam um arquivo local
# (server/data/community.json) e já funcionam. Para produção/multiusuário,
# aponte o MySQL da Hostinger preenchendo abaixo (ou use DATABASE_URL):
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Alternativa numa linha só (tem prioridade sobre as MYSQL_* acima):
# DATABASE_URL=mysql://usuario:senha@host:3306/nome_do_banco

# SERVIDOR TURN (necessário para chamadas entre pessoas em REDES DIFERENTES,
# atravessando firewalls/NAT). Sem isto, só STUN público é usado — funciona
# na mesma rede, mas pode falhar entre internets distintas. Ao subir um TURN
# (ex.: coturn na VPS), preencha:
# TURN_URL=turn:SEU_IP:3478
# TURN_USERNAME=usuario
# TURN_CREDENTIAL=senha

# ============================================================
#  GATHER (opcional) — Bot Status Monitor: mostra no escritório virtual
#  se o Shadow está ligado, pensando ou com erro.
#   1. No Gather: Decorate Desk -> Interactive -> Bot Status Monitor
#   2. Clique no objeto -> copie a "URL do Webhook" e o "segredo" (whsec_...)
# ============================================================
GATHER_WEBHOOK_URL=
GATHER_WEBHOOK_SECRET=

# Inbox (opcional) — manda cada mensagem nova das Salas como item de
# atividade num objeto "Inbox" do Gather (mesmo esquema: Decorate Desk ->
# Interactive -> Inbox, depois copie URL + segredo).
GATHER_INBOX_WEBHOOK_URL=
GATHER_INBOX_WEBHOOK_SECRET=
